{
	"$schema": "../node_modules/wrangler/config-schema.json",
	"name": "pin-dou-pixelizer",
	"main": "src/index.ts",
	"compatibility_date": "2026-08-11",
	"compatibility_flags": ["nodejs_compat"],
	"routes": [
		{
			"pattern": "api.pindou.kuizuo.me",
			"custom_domain": true
		}
	],
	"ai": { "binding": "AI", "remote": true },
	"ratelimits": [
		{
			"name": "PIXEL_RATE_LIMITER",
			"namespace_id": "1001",
			"simple": { "limit": 3, "period": 60 }
		}
	],
	"vars": {
		"ALLOWED_ORIGINS": "https://pindou.kuizuo.me,https://pin-dou-generator.pages.dev"
	},
	"observability": {
		"enabled": true,
		"logs": { "enabled": true, "head_sampling_rate": 1 },
		"traces": { "enabled": true, "head_sampling_rate": 0.01 }
	}
}
