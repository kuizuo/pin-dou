{
  "name": "fuse-beads-generator",
  "version": "1.0.0",
  "keywords": "fuse-beads, pindou, image-to-pixel",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build && node scripts/prepare-standalone.mjs",
    "deploy": "opennextjs-cloudflare build && opennextjs-cloudflare deploy",
    "preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "start": "node .next/standalone/server.js",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "worker:dev": "wrangler dev --config worker/wrangler.jsonc",
    "worker:types": "wrangler types --config worker/wrangler.jsonc worker/worker-configuration.d.ts",
    "worker:check": "wrangler deploy --dry-run --config worker/wrangler.jsonc"
  },
  "dependencies": {
    "@base-ui/react": "^1.7.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "heic2any": "0.0.4",
    "lucide-react": "latest",
    "magic-wand-tool": "1.1.7",
    "next": "16.3.0",
    "react": "latest",
    "react-dom": "latest",
    "react-image-crop": "11.1.2",
    "react-zoom-pan-pinch": "4.0.4",
    "shadcn": "^4.16.2",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "zod": "latest"
  },
  "devDependencies": {
    "@opennextjs/cloudflare": "^1.20.2",
    "@stylistic/eslint-plugin": "^5.10.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "latest",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "esbuild": "^0.28.2",
    "eslint": "^9.0.0",
    "eslint-config-next": "16.3.0",
    "eslint-plugin-perfectionist": "^5.10.1",
    "jsdom": "latest",
    "postcss": "^8.5.26",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.0",
    "vitest": "latest",
    "wrangler": "4.121.0"
  }
}
